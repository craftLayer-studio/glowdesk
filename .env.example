# Public base URL used in QR codes and share links. Dev: http://localhost:3141
APP_URL=https://glowdesk.craftlayer.store
# 32+ random characters. Signs the staff session cookie.
SESSION_SECRET=
# Optional: real Postgres. Without it, PGlite stores data in ./.data/pglite.
DATABASE_URL=
# Demo mode shows OTP codes on screen. Set to false for a real salon.
DEMO_MODE=true
